# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase anon/public key (reserved for future browser-side usage, not exposed by this server)
SUPABASE_KEY=

# Supabase service role key (server-side only, high privileges, NEVER sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Admin API key used to authenticate /api/admin/* routes (Authorization: Bearer <key>)
# Make it long and random, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO